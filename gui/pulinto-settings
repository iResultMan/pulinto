                          "ctrl:swap_lwin_lctl. Details are in the manual, section \"Apple "
                          "keyboard\".")
        )
        page.add(hint)
        self.append(page)

    @guarded
    def refresh(self):
        try:
            self.info = json.loads(self.daemon.call("KeyboardInfo"))
        except (ValueError, TypeError):
            self.info = {}
        if not self.info:
            self.keyboard_value.set_text(_("unavailable"))
            self.switch.set_sensitive(False)
            self.layouts_value.set_text("")
            self.banner.set_revealed(False)
            return
        info = self.info
        self.keyboard_value.set_text(_("found") if info.get("apple_keyboard") else _("not found"))
        layouts = info.get("layouts") or []
        variants = info.get("variants") or []
        self.layouts_value.set_text(
            ", ".join(
                f"{name}({variant})" if variant else name
                for name, variant in zip(layouts, variants + [""] * len(layouts))
            )
            or _("unknown")
        )
        self._refreshing = True
        self.switch.set_active(bool(info.get("apple_layout")))
        self._refreshing = False

        problem = None
        restart = False
        if not info.get("can_apply"):
            problem = _("setxkbmap not found (package x11-xkb-utils): the layout cannot be "
                        "switched from here.")
        elif info.get("foreign_variant") and not info.get("apple_layout"):
            problem = (
                _("The Russian layout uses the \"{variant}\" variant; the Apple layout is not "
                  "applied over it, so your choice is kept.").format(
                    variant=info["foreign_variant"]
                )
            )
        elif info.get("restart_needed"):
            problem = _("The system layout changed after PuLinTo started. Restart it.")
            restart = True
        self.switch.set_sensitive(
            bool(info.get("can_apply"))
            and not (info.get("foreign_variant") and not info.get("apple_layout"))
        )
        self.banner.set_button_label(_("Restart") if restart else None)
        if problem:
            self.banner.set_title(problem)
        self.banner.set_revealed(bool(problem))

    def on_toggle(self, row, _param):
        if self._refreshing:
            return
        state = row.get_active()
        try:
            ok, reason = self.daemon.call("SetAppleLayout", "(b)", state)
        except GLib.Error as error:
            ok, reason = False, str(error)
        if not ok:
            alert(self.win, _("The layout was not changed"), reason)
            self._refreshing = True
            row.set_active(not state)
            self._refreshing = False
            return
        if not state:
            # Switched off by hand: do not offer it again.
            remember_gui_state(apple_suggestion_dismissed=True)
        self.win.wait_for_daemon(
            _("Apple layout turned on") if state else _("Standard layout restored")
        )


