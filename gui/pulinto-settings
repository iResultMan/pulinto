# Interface language. The strings in the code are English, the source language;
# the catalogues are `po/{ru,it}.po`, compiled to `pulinto.mo` (they sit in
# `data/locale`). Without a catalogue the English text of the code is
# shown, which is what every other language gets: a person who reads neither
# Russian nor Italian is likelier to read English.
LANGUAGE_CODES = ("ru", "en", "it")


def config_file():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(base, "pulinto", "config.conf")


def language_choice():
    """What the user picked: "ru", "en", "it", or "auto" (follow the system).
    The daemon keeps it in the config file; the tray and this window share it."""
    try:
        with open(config_file(), encoding="utf-8") as handle:
            for line in handle:
                key, _sep, value = line.partition("=")
                if key.strip() == "language":
                    value = value.strip()
                    return value if value in LANGUAGE_CODES else "auto"
    except OSError:
        pass
    return "auto"


def write_language_choice(choice):
    """Used only when the daemon cannot be asked: keeps every other line."""
    path = config_file()
    try:
        with open(path, encoding="utf-8") as handle:
            lines = handle.read().split("\n")
    except OSError:
        lines = []
    line = "language = " + choice
    for index, old in enumerate(lines):
        if old.partition("=")[0].strip() == "language":
            lines[index] = line
            break
    else:
        lines.append(line)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as handle:
        handle.write("\n".join(lines).rstrip("\n") + "\n")


def ui_language():
    chosen = language_choice()
    if chosen != "auto":
        return chosen
    for name in ("PULINTO_LANG", "LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG"):
        for part in os.environ.get(name, "").split(":"):
            code = part.split(".")[0].split("_")[0].split("@")[0].lower()
            if code in ("", "c", "posix"):
                continue
            return code if code in ("ru", "it") else "en"
    return "en"


def locale_dirs():
    here = os.path.dirname(os.path.realpath(__file__))
    data_home = os.environ.get("XDG_DATA_HOME") or os.path.join(os.path.expanduser("~"), ".local", "share")
    return [
        os.environ.get("PULINTO_LOCALE_DIR", ""),
        os.path.join(here, "..", "share", "pulinto", "locale"),
        os.path.join(data_home, "pulinto", "locale"),
        "/usr/local/share/pulinto/locale",
        "/usr/share/pulinto/locale",
        os.path.join(here, "..", "data", "locale"),
    ]


LANGUAGE = ui_language()
LANGUAGE_CHOICE = language_choice()
_catalogue = gettext.NullTranslations()
for directory in filter(None, locale_dirs()):
    if gettext.find("pulinto", directory, [LANGUAGE]):
        _catalogue = gettext.translation("pulinto", directory, [LANGUAGE])
        break


def _(text):
    return _catalogue.gettext(text)


# Native names, never translated: a person who cannot read the current language
# must still find their own.
LANGUAGE_NAMES = (("ru", "Русский"), ("en", "English"), ("it", "Italiano"))


def language_menu():
    """The "Interface language" submenu: one radio item per language, bound to
    the `win.language` action of the window that shows it."""
    menu = Gio.Menu()
    for code, label in (("auto", _("System language")),) + LANGUAGE_NAMES:
        item = Gio.MenuItem.new(label, None)
        item.set_action_and_target_value("win.language", GLib.Variant("s", code))
        menu.append_item(item)
    return menu


def install_language_action(window, daemon, page_name):
    """Adds `win.language` to a window. Choosing a language saves it (through
    the daemon, so the tray follows at once) and starts the window again in
    that language, on the same page: a window cannot be re-translated in place."""
    action = Gio.SimpleAction.new_stateful("language", GLib.VariantType("s"), GLib.Variant("s", LANGUAGE_CHOICE))

    def chosen(_action, parameter):
        choice = parameter.get_string()
        if choice == LANGUAGE_CHOICE:
            return
        try:
            if daemon is None or not daemon.call("SetLanguage", "(s)", choice):
                raise RuntimeError("refused")
        except (GLib.Error, RuntimeError):
            try:
                write_language_choice(choice)
            except OSError as error:
                alert(window, _("Could not save the language"), str(error))
                return
        restart_window(page_name())

    action.connect("activate", chosen)
    window.add_action(action)


def restart_window(page=None):
    if page:
        os.environ["PULINTO_SETTINGS_PAGE"] = page
    os.execv(sys.executable, [sys.executable] + sys.argv)


