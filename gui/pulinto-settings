class ListPage(Gtk.Box):
    """A page that is a searchable list of rules, or an empty state."""

    can_add = True
    searchable = True

    def __init__(self, win, daemon, name, title, intro, icon, empty_title, empty_text, empty_action):
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        self.win = win
        self.daemon = daemon
        self.name = name
        self.title = title
        self.search_text = ""

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, vexpand=True)
        self.append(self.stack)

        self.content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        self.content.append(dim_label(intro))
        clamp = Adw.Clamp(
            maximum_size=700,
            tightening_threshold=540,
            margin_top=18,
            margin_bottom=24,
            margin_start=16,
            margin_end=16,
            child=self.content,
        )
        scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, child=clamp)
        self.stack.add_named(scroller, "list")

        status = Adw.StatusPage(icon_name=icon, title=empty_title, description=empty_text)
        status.add_css_class("compact")
        status.set_child(pill_button(empty_action, self.add))
        self.stack.add_named(status, "empty")

    def make_listbox(self):
        listbox = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        listbox.add_css_class("boxed-list")
        listbox.set_filter_func(self._filter_row)
        listbox.set_placeholder(dim_label(_("Nothing found"), margin_top=18, margin_bottom=18, halign=Gtk.Align.CENTER))
        listbox.connect("row-activated", lambda _box, row: self.edit_row(row))
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self._on_key)
        listbox.add_controller(keys)
        return listbox

    def _on_key(self, _controller, keyval, _keycode, _state):
        if keyval in (Gdk.KEY_Delete, Gdk.KEY_KP_Delete):
            widget = self.win.get_focus()
            while widget is not None and not isinstance(widget, Gtk.ListBoxRow):
                widget = widget.get_parent()
            if widget is not None and hasattr(widget, "rule"):
                self.delete_row(widget)
                return True
        return False

    def _filter_row(self, row):
        needle = self.search_text
        return not needle or needle in getattr(row, "search_key", "")

    def set_search(self, text):
        self.search_text = text.strip().lower()
        for listbox in self.listboxes():
            listbox.invalidate_filter()

    def listboxes(self):
        return []

    def show_rows(self, has_rows):
        self.stack.set_visible_child_name("list" if has_rows else "empty")

    @staticmethod
    def clear(listbox):
        while (row := listbox.get_row_at_index(0)) is not None:
            listbox.remove(row)

    # Hooks for subclasses.
    def add(self):
        raise NotImplementedError

    def edit_row(self, row):
        raise NotImplementedError

    def delete_row(self, row):
        raise NotImplementedError


class RulesPage(ListPage):
    """Replacements and the never/always word lists share one implementation."""

    TEXTS = {
        "replacement": dict(
            title=_("Autocorrections"),
            intro=_("Replace a word or abbreviation after a space or punctuation mark. The "
                    "replacement may contain spaces. Click a row to edit."),
            icon="edit-find-replace-symbolic",
            empty_title=_("No autocorrections yet"),
            empty_text=_("Add an abbreviation: PuLinTo expands it as soon as you finish the word."),
            empty_action=_("Add an autocorrection"),
        ),
        "never": dict(
            title=_("Never change"),
            intro=_("Words for which automatic layout switching is forbidden. Click a row to edit."),
            icon="action-unavailable-symbolic",
            empty_title=_("No exceptions yet"),
            empty_text=_("PuLinTo does not touch the words in this list, in any application, "
                         "unless you limit the rule."),
            empty_action=_("Add a word"),
        ),
        "always": dict(
            title=_("Always change"),
            intro=_("Words that must be converted even when the automatic logic is unsure. Click a "
                    "row to edit."),
            icon="object-flip-horizontal-symbolic",
            empty_title=_("No words of your own yet"),
            empty_text=_("Words from here will be converted even when PuLinTo is unsure."),
            empty_action=_("Add a word"),
        ),
    }
    PAGE_NAME = {"replacement": "replacements", "never": "never", "always": "always"}
    LIST_METHOD = {
        "replacement": "ListReplacementRules",
        "never": "ListExclusionRules",
        "always": "ListInclusionRules",
    }
    REMOVE_METHOD = {
        "replacement": "RemoveReplacement",
        "never": "RemoveExclusion",
        "always": "RemoveInclusion",
    }
    ORIGINS = {
        "learned": _("Learned automatically"),
        "manual": _("Added by hand"),
        "legacy": _("Added earlier"),
    }

    def __init__(self, win, daemon, kind):
        texts = self.TEXTS[kind]
        super().__init__(
            win,
            daemon,
            self.PAGE_NAME[kind],
            texts["title"],
            texts["intro"],
            texts["icon"],
            texts["empty_title"],
            texts["empty_text"],
            texts["empty_action"],
        )
        self.kind = kind
        self.entries = []

        self.listbox = self.make_listbox()
        self.content.append(self.listbox)

        if kind in ("never", "always"):
            self.forgotten_row = Adw.ActionRow(title=_("Forgotten words"), use_markup=False)
            reset = Gtk.Button(label=_("Reset…"), valign=Gtk.Align.CENTER)
            reset.connect("clicked", lambda *_: self.clear_forgotten())
            self.forgotten_row.add_suffix(reset)
            self.forgotten_group = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, visible=False)
            self.forgotten_group.add_css_class("boxed-list")
            self.forgotten_group.append(self.forgotten_row)
            # Pinned under the stack so it stays reachable when the list is empty.
            self.append(
                Adw.Clamp(
                    maximum_size=700,
                    margin_bottom=16,
                    margin_start=16,
                    margin_end=16,
                    child=self.forgotten_group,
                )
            )

    def listboxes(self):
        return [self.listbox]

    def rows(self):
        return list(self.entries)

    def _build_row(self, source, replacement, scope, origin, learned):
        row = plain_row(source)
        row.set_title_lines(1)
        if replacement:
            row.set_subtitle(f"→ {replacement}" if self.kind == "replacement" else _("becomes: "
                                                                                     "{replacement}").format(replacement=replacement))
            row.set_subtitle_lines(1)
        origin_display = self.ORIGINS.get(origin, _("Added earlier") if origin else "")
        row.set_tooltip_text(origin_display or None)
        row.set_activatable(True)
        if learned:
            row.add_suffix(chip(_("learned"), _("The rule was learned automatically after repeated "
                                                "corrections")))
        if scope:
            label = value_label(scope)
            label.set_ellipsize(Pango.EllipsizeMode.END)
            label.set_max_width_chars(28)
            label.set_tooltip_text(_("Only in: {scope}").format(scope=scope))
            row.add_suffix(label)
        row.add_suffix(icon_button("document-edit-symbolic", _("Edit"), lambda r=row: self.edit_row(r)))
        row.add_suffix(icon_button("user-trash-symbolic", _("Delete"), lambda r=row: self.delete_row(r)))
        row.rule = (source, replacement, scope)
        row.search_key = " ".join(
            part.lower() for part in (source, replacement, scope, origin_display) if part
        )
        return row

    @guarded
    def refresh(self):
        lines = self.daemon.call(self.LIST_METHOD[self.kind])
        self.clear(self.listbox)
        self.entries = []
        for line in lines:
            fields = line.split("\t", 2)
            fields += [""] * (3 - len(fields))
            if self.kind == "replacement":
                source, replacement, scope = fields
                origin = ""
            else:
                source, scope, origin = fields
                replacement = (
                    self.daemon.call("PreviewLayoutConversion", "(s)", source)
                    if self.kind == "always"
                    else ""
                )
            self.entries.append((source, replacement, scope))
            self.listbox.append(self._build_row(source, replacement, scope, origin, origin == "learned"))
        self.show_rows(bool(self.entries))
        self.win.set_count(self.name, len(self.entries))
        if self.kind in ("never", "always"):
            count = self.daemon.call("ForgottenWordCount")
            self.forgotten_group.set_visible(count > 0)
            self.forgotten_row.set_subtitle(
                _("{count} forbidden from being learned again").format(count=plural(count, "word", "words"))
            )

    # -- actions ---------------------------------------------------------

    def add(self):
        self.open_form()

    def edit_row(self, row):
        self.open_form(*row.rule)

    def remove_rule(self, source):
        self.daemon.call(self.REMOVE_METHOD[self.kind], "(s)", source)

    def apply_rule(self, source, replacement, scope):
        if self.kind == "replacement":
            return self.daemon.call("AddScopedReplacement", "(sss)", source, replacement, scope)
        if self.kind == "never":
            return self.daemon.call("ExcludeWordScoped", "(ss)", source, scope)
        return self.daemon.call("IncludeWordScoped", "(ss)", source, scope)

    @guarded
    def delete_row(self, row):
        source, replacement, scope = row.rule

        def undo():
            if self.apply_rule(source, replacement, scope):
                self.win.refresh_all()

        if self.kind == "replacement":
            self.remove_rule(source)
            self.win.refresh_all()
            self.win.toast(_("Autocorrection deleted"), undo=undo)
            return

        dialog = Adw.AlertDialog(
            heading=_("Delete \"{source}\"?").format(source=source),
            body=_("\"Delete\" lets PuLinTo learn the word again. \"Delete and forget\" forbids "
                   "learning it again; only a protected fingerprint is written to disk."),
        )
        dialog.add_response("cancel", _("Cancel"))
        dialog.add_response("delete", _("Delete"))
        dialog.add_response("forget", _("Delete and forget"))
        dialog.set_response_appearance("forget", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")
        dialog.connect("response", lambda _d, response: self._finish_delete(response, source, undo))
        dialog.present(self.win)

    @guarded
    def _finish_delete(self, response, source, undo):
        if response == "delete":
            self.remove_rule(source)
            self.win.refresh_all()
            self.win.toast(_("Word deleted"), undo=undo)
        elif response == "forget":
            self.daemon.call("ForgetWord", "(s)", source)
            self.win.refresh_all()
            self.win.toast(_("Word deleted and forgotten"))

    def clear_forgotten(self):
        dialog = Adw.AlertDialog(
            heading=_("Allow forgotten words to be learned again?"),
            body=_("The words themselves are not stored, so the whole set of protected "
                   "fingerprints is cleared."),
        )
        dialog.add_response("cancel", _("Cancel"))
        dialog.add_response("reset", _("Allow"))
        dialog.set_response_appearance("reset", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_close_response("cancel")
        dialog.connect("response", lambda _d, response: self._finish_clear(response))
        dialog.present(self.win)

    @guarded
    def _finish_clear(self, response):
        if response == "reset":
            self.daemon.call("ClearForgottenWords")
            self.win.refresh_all()
            self.win.toast(_("Forgotten words reset"))

    def open_form(self, source="", replacement="", scope=""):
        editing = bool(source)
        kind = self.kind
        titles = {
            "replacement": (_("Edit autocorrection"), _("New autocorrection")),
            "never": (_("Edit word"), _("Never change a word")),
            "always": (_("Edit word"), _("Always change a word")),
        }
        win = self.win

        def on_save():
            new_source = source_row.get_text().strip()
            new_replacement = replacement_row.get_text() if kind == "replacement" else ""
            new_scope = scope_row.get_text().strip()
            try:
                ok = self.apply_rule(new_source, new_replacement, new_scope)
                if ok and editing and new_source.lower() != source.lower():
                    self.remove_rule(source)
            except GLib.Error as error:
                win.daemon_failed(error)
                return _("No connection to PuLinTo.")
            if not ok:
                return (
                    _("The rule was not saved. Check that the fields are filled in; a word for the "
                      "layout lists must be at least 3 characters.")
                )
            win.refresh_all()
            win.toast(_("Saved"))
            return None

        dialog = FormDialog(titles[kind][0 if editing else 1], on_save)

        main = Adw.PreferencesGroup()
        source_row = Adw.EntryRow(title=_("What was typed") if kind == "replacement" else _("Word"), text=source)
        main.add(source_row)
        dialog.watch(source_row)
        dialog.require(lambda: bool(source_row.get_text().strip()))

        replacement_row = None
        if kind == "replacement":
            replacement_row = Adw.EntryRow(title=_("Replace with"), text=replacement)
            main.add(replacement_row)
            dialog.watch(replacement_row)
            dialog.require(lambda: bool(replacement_row.get_text()))
        elif kind == "always":
            preview = Adw.ActionRow(title=_("Becomes"), use_markup=False)
            preview_value = Gtk.Label(xalign=1, valign=Gtk.Align.CENTER)
            # A pasted paragraph must not stretch the dialog off the screen.
            preview_value.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
            preview_value.set_max_width_chars(40)
            preview_value.add_css_class("mono")
            preview.add_suffix(preview_value)
            main.add(preview)

            def update_preview(*_):
                value = source_row.get_text().strip()
                try:
                    preview_value.set_text(
                        self.daemon.call("PreviewLayoutConversion", "(s)", value) if value else "—"
                    )
                except GLib.Error:
                    preview_value.set_text("—")

            source_row.connect("changed", update_preview)
            update_preview()
        dialog.add_group(main)

        where = Adw.PreferencesGroup(
            title=_("Where it applies"),
            description=_("Leave empty and the rule works in all applications. You can list "
                          "several, separated by commas: Navigator, code, jetbrains-* (a star at "
                          "the end means the whole family)."),
        )
        scope_row = Adw.EntryRow(title=_("Applications (WM_CLASS)"), text=scope)
        where.add(scope_row)
        dialog.watch(scope_row)
        origin_app = win.origin_app
        if origin_app:
            origin = Adw.ActionRow(
                title=_("Add \"{app}\"").format(app=origin_app),
                subtitle=_("The application the settings were opened from"),
                use_markup=False,
                activatable=True,
            )
            origin.add_prefix(Gtk.Image(icon_name="list-add-symbolic"))

            def use_origin(*_):
                current = [part.strip() for part in scope_row.get_text().split(",") if part.strip()]
                if origin_app.lower() not in [part.lower() for part in current]:
                    current.append(origin_app)
                scope_row.set_text(",".join(current))

            origin.connect("activated", use_origin)
            where.add(origin)
        dialog.add_group(where)

        dialog.finish_layout()
        dialog.present(win)
        GLib.idle_add(source_row.grab_focus)


class ApplicationsPage(ListPage):
    MODES = {
