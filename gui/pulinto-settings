class SettingsWindow(Adw.ApplicationWindow):
    SIDEBAR = (
        ("overview", _("Overview"), "go-home-symbolic"),
        ("replacements", _("Autocorrections"), "edit-find-replace-symbolic"),
        ("never", _("Never change"), "action-unavailable-symbolic"),
        ("always", _("Always change"), "object-flip-horizontal-symbolic"),
        ("apps", _("Applications"), "view-app-grid-symbolic"),
        ("keyboard", _("Apple keyboard"), "input-keyboard-symbolic"),
        ("hotkeys", _("Hotkeys"), "preferences-desktop-keyboard-symbolic"),
        ("diagnostics", _("Diagnostics"), "applications-engineering-symbolic"),
        ("help", _("Help"), "help-about-symbolic"),
    )

    def __init__(self, application, daemon):
        super().__init__(application=application, title="PuLinTo", default_width=940, default_height=640)
        self.set_size_request(360, 360)
        self.daemon = daemon
        self.origin_app = os.environ.get("PULINTO_ORIGIN_APP", "").strip()
        self.pages = {}
        self.counts = {}
        self.current = None
        self.restart_done_text = ""
        self.restart_attempts = 0
        self._failure_shown = False

        self.overview = OverviewPage(self, daemon)
        self.replacements = RulesPage(self, daemon, "replacement")
        self.never = RulesPage(self, daemon, "never")
        self.always = RulesPage(self, daemon, "always")
        self.apps = ApplicationsPage(self, daemon)
        self.keyboard = KeyboardPage(self, daemon)
        self.hotkeys = HotkeysPage(self, daemon)
        self.diagnostics = DiagnosticsPage(self, daemon)
        self.help = HelpPage(self)

        self.content_stack = Gtk.Stack(
            transition_type=Gtk.StackTransitionType.CROSSFADE, transition_duration=140
        )
        for page in (
            self.overview,
            self.replacements,
            self.never,
            self.always,
            self.apps,
            self.keyboard,
            self.hotkeys,
            self.diagnostics,
            self.help,
        ):
