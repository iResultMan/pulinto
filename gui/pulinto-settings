            self.content_stack.add_named(page, page.name)

        self.build_actions()
        install_language_action(self, self.daemon, lambda: self.current.name)
        self.build_layout()

        self.refresh_all()
        initial = os.environ.get("PULINTO_SETTINGS_PAGE", "").strip()
