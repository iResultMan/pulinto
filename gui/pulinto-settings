    # -- navigation ------------------------------------------------------

    def show_page(self, name, reveal=True):
        self.sidebar.select_row(self.sidebar_rows[name])
        if reveal:
            self.split.set_show_content(True)

    def on_sidebar_selected(self, _box, row):
        if row is None:
            return
        name = row.page_name
        page = self.pages[name]
        # Clear the search while the old page is still current: the empty
        # filter must reach the page that was filtered, not the new one.
        self.search_button.set_active(False)
        self.search_entry.set_text("")
        self.current = page
        self.content_stack.set_visible_child_name(name)
        self.content_page.set_title(page.title)
        self.content_title.set_title(page.title)
        self.add_button.set_visible(page.can_add)
        self.search_button.set_visible(page.searchable)
        self.lookup_action("add").set_enabled(page.can_add)
        self.lookup_action("find").set_enabled(page.searchable)
        if page.can_add:
            self.add_button.set_tooltip_text(_("Add — {title} (Ctrl+N)").format(title=page.title))

    def set_count(self, name, count):
        label = self.counts[name]
        label.set_text(str(count))
        label.set_visible(count > 0)

    def add_to_current(self):
        if self.current is not None and self.current.can_add:
            self.current.add()

    def focus_search(self):
        if self.current is not None and self.current.searchable:
            self.search_button.set_active(True)
            self.search_entry.grab_focus()

    def on_search_changed(self, entry):
        if self.current is not None and self.current.searchable:
            self.current.set_search(entry.get_text())

    def on_search_mode(self, bar, _param):
        if not bar.get_search_mode() and self.current is not None:
            self.search_entry.set_text("")
            if self.current.searchable:
                self.current.set_search("")

    def on_active_changed(self, *_):
        if self.is_active():
            self.update_status()

    # -- feedback --------------------------------------------------------

    def toast(self, text, undo=None):
        toast = Adw.Toast(title=text, timeout=5 if undo else 3)
        if undo is not None:
            toast.set_button_label(_("Undo"))

            def on_undo(*_):
                try:
                    undo()
                except GLib.Error as error:
                    self.daemon_failed(error)

            toast.connect("button-clicked", on_undo)
        self.overlay.add_toast(toast)

    def daemon_failed(self, error):
        self.overview.update(None)
        if self._failure_shown:
            return  # one refresh can fail five times; say it once
        self._failure_shown = True
        dialog = alert(self, _("Could not reach pulintod"), str(error))
        dialog.connect("closed", lambda *_: setattr(self, "_failure_shown", False))

    # -- data ------------------------------------------------------------

    def refresh_all(self):
        self.replacements.refresh()
        self.never.refresh()
        self.always.refresh()
        self.apps.refresh()
        self.keyboard.refresh()
        self.hotkeys.refresh()
        self.diagnostics.refresh()
        self.update_suggestion()
        self.update_status()

    @guarded
    def safe_refresh(self):
        self.refresh_all()
        self.toast(_("Lists refreshed"))

    def update_status(self):
        try:
            status = json.loads(self.daemon.call("Status"))
        except (GLib.Error, ValueError, TypeError):
            status = None
        self.overview.update(status)
        # The language was changed elsewhere (the tray menu): follow it.
        if status and status.get("language_choice", LANGUAGE_CHOICE) != LANGUAGE_CHOICE:
            restart_window(self.current.name)

    def update_suggestion(self):
        info = self.keyboard.info
        offer = bool(
            info.get("apple_keyboard")
            and not info.get("apple_layout")
            and info.get("can_apply")
            and not info.get("foreign_variant")
            and not gui_state().get("apple_suggestion_dismissed")
        )
        self.overview.show_suggestion(offer)

    def wait_for_daemon(self, done_text):
        """The daemon restarts itself after some changes: wait until it answers."""
        self.restart_done_text = done_text
        self.restart_attempts = 0
        self.toast(_("Applying…"))
        GLib.timeout_add(300, self.wait_for_restart)

    def restart_input(self):
        try:
            if not self.daemon.call("RestartInput"):
                raise RuntimeError(_("the daemon rejected the restart"))
        except (GLib.Error, RuntimeError) as error:
            alert(self, _("Could not restart PuLinTo"), str(error))
            return
        self.toast(_("Restarting PuLinTo…"))
        self.wait_for_daemon(_("PuLinTo restarted, keyboards re-checked"))

    def wait_for_restart(self):
        self.restart_attempts += 1
        try:
            status = json.loads(self.daemon.call("Status"))
            if status.get("status") == "running":
                self.refresh_all()
                self.toast(self.restart_done_text)
                return False
        except (GLib.Error, ValueError, TypeError):
            pass
        if self.restart_attempts < 20:
            return True
        self.overview.update(None)
        alert(
            self,
            _("PuLinTo did not come back after the restart"),
            _("Try starting PuLinTo from the application menu."),
        )
        return False

    # -- import / export -------------------------------------------------

    def export_payload(self):
        def scopes(text):
            return [part.strip() for part in text.split(",") if part.strip()]

        return {
            "format": "pulinto-rules",
            "version": 1,
            "replacements": [
                {"source": source, "replacement": replacement, "applications": scopes(scope)}
                for source, replacement, scope in self.replacements.rows()
            ],
            "never_change": [
                {"word": word, "applications": scopes(scope)}
                for word, _unused, scope in self.never.rows()
            ],
            "always_change": [
                {"word": word, "applications": scopes(scope)}
                for word, _unused, scope in self.always.rows()
            ],
            "applications": {
                "enabled": [app for app, mode in self.apps.explicit_rows() if mode == "auto"],
                "manual": [app for app, mode in self.apps.explicit_rows() if mode == "manual"],
                "disabled": [app for app, mode in self.apps.explicit_rows() if mode == "off"],
            },
        }

    @staticmethod
    def json_filter():
        file_filter = Gtk.FileFilter(name=_("PuLinTo rules (JSON)"))
        file_filter.add_pattern("*.json")
        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(file_filter)
        return filters

    def export_rules(self):
        dialog = Gtk.FileDialog(title=_("Export PuLinTo rules"), accept_label=_("Save"))
        dialog.set_initial_name("pulinto-rules.json")
        dialog.set_filters(self.json_filter())
        dialog.save(self, None, self._export_chosen)

    def _export_chosen(self, dialog, result):
        try:
            path = dialog.save_finish(result).get_path()
        except GLib.Error as error:
            # Cancelled is the user's choice; anything else is the portal's
            # fault and must not pass for one.
            if not error.matches(Gtk.DialogError.quark(), Gtk.DialogError.DISMISSED):
                print(f"экспорт: диалог файлов не ответил: {error}", file=sys.stderr)
            return
        try:
            with open(path, "w", encoding="utf-8") as handle:
                json.dump(self.export_payload(), handle, ensure_ascii=False, indent=2)
                handle.write("\n")
            self.toast(_("Rules saved to the file"))
        except (OSError, TypeError) as error:
            alert(self, _("Export failed"), str(error))

    def import_rules(self):
        dialog = Gtk.FileDialog(title=_("Import PuLinTo rules"), accept_label=_("Open"))
        dialog.set_filters(self.json_filter())
        dialog.open(self, None, self._import_chosen)

    def _import_chosen(self, dialog, result):
        try:
            path = dialog.open_finish(result).get_path()
        except GLib.Error as error:
            if not error.matches(Gtk.DialogError.quark(), Gtk.DialogError.DISMISSED):
                print(f"импорт: диалог файлов не ответил: {error}", file=sys.stderr)
            return
        try:
            with open(path, "r", encoding="utf-8") as handle:
                payload = self.validate_payload(json.load(handle))
        except (OSError, ValueError, TypeError) as error:
            alert(self, _("The rules file is invalid"), str(error))
            return

        ask = Adw.AlertDialog(
            heading=_("How should the rules be imported?"),
            body=_("Merging updates matching rules. Replacing first deletes the current user rules."),
        )
        ask.add_response("cancel", _("Cancel"))
        ask.add_response("replace", _("Replace current"))
        ask.add_response("merge", _("Merge"))
        ask.set_response_appearance("replace", Adw.ResponseAppearance.DESTRUCTIVE)
        ask.set_response_appearance("merge", Adw.ResponseAppearance.SUGGESTED)
        ask.set_default_response("merge")
        ask.set_close_response("cancel")
        ask.connect("response", lambda _d, response: self._finish_import(response, payload))
        ask.present(self)

    def _finish_import(self, response, payload):
        if response not in ("replace", "merge"):
            return
        try:
            if response == "replace":
                self.clear_user_rules()
            self.apply_payload(payload)
            self.refresh_all()
            self.toast(_("Rules imported"))
        except (GLib.Error, ValueError) as error:
            self.refresh_all()
            alert(self, _("The import was not completed"), str(error))

    @staticmethod
    def validate_payload(payload):
        if not isinstance(payload, dict) or payload.get("format") != "pulinto-rules":
            raise ValueError(_("This is not a PuLinTo rules file"))
        if payload.get("version") != 1:
            raise ValueError(_("Unsupported format version"))

        def text(value, name, allow_empty=False):
            if not isinstance(value, str) or (not allow_empty and not value):
                raise ValueError(_("Invalid field {name}").format(name=name))
            if any(ch in value for ch in "\t\r\n"):
                raise ValueError(_("Field {name} contains an invalid control character").format(name=name))
            return value

        def scope(item):
            values = item.get("applications", [])
            if not isinstance(values, list):
                raise ValueError(_("applications must be an array"))
            return ",".join(text(value, "applications") for value in values)

        replacements = []
        for item in payload.get("replacements", []):
            if not isinstance(item, dict):
                raise ValueError(_("Invalid autocorrection"))
            replacements.append(
                (text(item.get("source"), "source"), text(item.get("replacement"), "replacement"), scope(item))
            )
        never = []
        for item in payload.get("never_change", []):
            if not isinstance(item, dict):
                raise ValueError(_("Invalid never_change rule"))
            never.append((text(item.get("word"), "word"), scope(item)))
        always = []
        for item in payload.get("always_change", []):
            if not isinstance(item, dict):
                raise ValueError(_("Invalid always_change rule"))
            always.append((text(item.get("word"), "word"), scope(item)))
        apps = payload.get("applications", {})
        if not isinstance(apps, dict):
            raise ValueError(_("Invalid applications section"))

        def app_list(name):
            values = apps.get(name, [])
            if not isinstance(values, list):
                raise ValueError(_("applications.{name} must be an array").format(name=name))
            return [text(value, name) for value in values]

        enabled = app_list("enabled")
        manual = app_list("manual")
        disabled = app_list("disabled")
        return replacements, never, always, enabled, manual, disabled

    def clear_user_rules(self):
        for source, _replacement, _scope in self.replacements.rows():
            self.daemon.call("RemoveReplacement", "(s)", source)
        for word, _replacement, _scope in self.never.rows():
            self.daemon.call("RemoveExclusion", "(s)", word)
        for word, _replacement, _scope in self.always.rows():
            self.daemon.call("RemoveInclusion", "(s)", word)
        for app, _mode in self.apps.explicit_rows():
            self.daemon.call("ResetAppPolicy", "(s)", app)

    def apply_payload(self, payload):
        replacements, never, always, enabled, manual, disabled = payload
        for source, replacement, scope in replacements:
            if not self.daemon.call("AddScopedReplacement", "(sss)", source, replacement, scope):
                raise ValueError(_("The daemon rejected the autocorrection"))
        for word, scope in never:
            if not self.daemon.call("ExcludeWordScoped", "(ss)", word, scope):
                raise ValueError(_("The daemon rejected the \"never change\" rule"))
        for word, scope in always:
            if not self.daemon.call("IncludeWordScoped", "(ss)", word, scope):
                raise ValueError(_("The daemon rejected the \"always change\" rule"))
        for app in enabled:
            self.daemon.call("SetAppMode", "(ss)", app, "auto")
        for app in manual:
            self.daemon.call("SetAppMode", "(ss)", app, "manual")
        for app in disabled:
            self.daemon.call("SetAppMode", "(ss)", app, "off")


class ErrorWindow(Adw.ApplicationWindow):
    """Shown instead of the settings when the daemon cannot be reached."""

    def __init__(self, application, error):
        super().__init__(application=application, title="PuLinTo", default_width=520, default_height=420)
        status = Adw.StatusPage(
            icon_name="dialog-warning-symbolic",
            title=_("PuLinTo is unavailable"),
            description=_("Could not reach the pulintod service.\n{error}").format(error=error),
        )
        status.add_css_class("compact")
        status.set_child(pill_button(_("Try again"), self.retry))
        view = Adw.ToolbarView()
        header = Adw.HeaderBar()
        header.pack_end(Gtk.MenuButton(icon_name="preferences-desktop-locale-symbolic", menu_model=language_menu(),
                                       tooltip_text=_("Interface language")))
        install_language_action(self, None, lambda: None)
        view.add_top_bar(header)
        view.set_content(status)
        self.set_content(view)

    def retry(self):
        # Open the new window first so the application never has zero windows.
        self.get_application().open_settings()
        self.close()


class SettingsApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id="ru.pulinto.Settings")

    def do_startup(self):
        Adw.Application.do_startup(self)
        display = Gdk.Display.get_default()
        provider = Gtk.CssProvider()
        provider.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(display, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def open_settings(self):
        try:
            daemon = connect_or_start_daemon()
        except (GLib.Error, RuntimeError) as error:
            ErrorWindow(self, error).present()
            return False
        SettingsWindow(self, daemon).present()
        return True

    def do_activate(self):
        window = self.get_active_window()
        if window:
            window.present()
        else:
            self.open_settings()


if __name__ == "__main__":
    GLib.set_prgname("pulinto-settings")
    GLib.set_application_name("PuLinTo")
    sys.exit(SettingsApp().run(sys.argv))
