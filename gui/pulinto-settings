class HotkeyRecorder(Adw.Dialog):
    """«Нажмите сочетание…»: запись делает демон, а не это окно.

    Окно GTK не видит ни Super, ни одиночных модификаторов, а под Wayland часть
    клавиш забирает композитор. Демон читает клавиатуру сам: он проглатывает
    следующее сочетание, отдаёт его строкой и ничего не сохраняет — сохраняет
    окно, когда человек подтвердил.
    """

    SECONDS = 10

    def __init__(self, page, scheme, action, title, subject, on_chosen):
        super().__init__(title=title, content_width=420)
        self.page = page
        self.daemon = page.daemon
        self.scheme = scheme
        self.action = action
        self.on_chosen = on_chosen
        self.binding = None
        self.left = self.SECONDS
        self.finished = False
        self.ticker = None

        header = Adw.HeaderBar(show_start_title_buttons=False, show_end_title_buttons=False)
        self.cancel_button = Gtk.Button(label=_("Cancel"))
        self.cancel_button.connect("clicked", lambda *_: self.close())
        self.save_button = Gtk.Button(label=_("Assign"), sensitive=False)
        self.save_button.add_css_class("suggested-action")
        self.save_button.connect("clicked", lambda *_: self.choose())
        header.pack_start(self.cancel_button)
        header.pack_end(self.save_button)

        body = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL, spacing=14,
            margin_top=12, margin_bottom=24, margin_start=18, margin_end=18,
        )
        self.subject = dim_label(subject)
        self.subject.set_xalign(0.5)
        self.prompt = Gtk.Label(label=_("Press a key combination"), wrap=True)
        self.prompt.add_css_class("title-3")
        self.shown = Gtk.Box(halign=Gtk.Align.CENTER, spacing=6, height_request=40)
        self.hint = dim_label(
            _("You can press and release a single modifier: Alt, Ctrl, Shift or Super. While "
              "recording, the other keys do nothing. Esc cancels."),
            justify=Gtk.Justification.CENTER,
        )
        self.hint.set_xalign(0.5)
        self.status = Gtk.Label(wrap=True, xalign=0.5, justify=Gtk.Justification.CENTER)
        self.status.add_css_class("dim-label")
        self.warning = Gtk.Label(wrap=True, xalign=0, visible=False)
        self.warning.add_css_class("warning")
        self.error = Gtk.Label(wrap=True, xalign=0, visible=False)
        self.error.add_css_class("error")
        self.again = Gtk.Button(label=_("Record again"), halign=Gtk.Align.CENTER, visible=False)
        self.again.connect("clicked", lambda *_: self.start())
        for widget in (self.subject, self.prompt, self.shown, self.status, self.hint, self.error, self.warning, self.again):
            body.append(widget)

        view = Adw.ToolbarView()
        view.add_top_bar(header)
        view.set_content(body)
        self.set_child(view)
        self.set_default_widget(self.save_button)
        self.connect("closed", self.on_closed)
        self.start()

    def show_keys(self, text, final=False):
        child = self.shown.get_first_child()
        while child is not None:
            following = child.get_next_sibling()
            self.shown.remove(child)
            child = following
        for part in [part for part in text.split("+") if part]:
            label = Gtk.Label(label=part)
            label.add_css_class("keycap")
            self.shown.append(label)
        if text and not final:
            label = Gtk.Label(label="…")
            label.add_css_class("dim-label")
            self.shown.append(label)

    def start(self):
        self.binding = None
        self.finished = False
        self.left = self.SECONDS
        self.save_button.set_sensitive(False)
        self.again.set_visible(False)
        self.error.set_visible(False)
        self.warning.set_visible(False)
        self.prompt.set_text(_("Press a key combination"))
        self.show_keys("")
        self.update_status()
        params = GLib.Variant("(ss)", (self.scheme, self.action))
        self.daemon.proxy.call(
            "RecordHotkey", params, Gio.DBusCallFlags.NONE, (self.SECONDS + 6) * 1000, None, self.on_answer
        )
        if self.ticker is None:
            self.ticker = GLib.timeout_add(100, self.tick)

    def tick(self):
        if self.finished:
            self.ticker = None
            return False
        self.left = max(0.0, self.left - 0.1)
        self.update_status()
        try:
            held = self.daemon.call("HotkeyRecordingProgress")
        except GLib.Error:
            held = ""
        if held:
            self.show_keys(held)
        return True

    def update_status(self):
        if self.finished:
            return
        self.status.set_text(_("{seconds} s left").format(seconds=int(self.left + 0.99)))

    def on_answer(self, proxy, result):
        self.finished = True
        try:
            answer = json.loads(proxy.call_finish(result).unpack()[0])
        except (GLib.Error, ValueError):
            answer = {"status": "error", "error": _("The daemon did not respond.")}
        status = answer.get("status")
        self.status.set_text("")
        if status == "recorded":
            self.binding = answer["binding"]
            self.prompt.set_text(_("Recorded"))
            self.show_keys(answer["label"], final=True)
            if answer.get("warnings"):
                self.warning.set_text("\n".join(answer["warnings"]))
                self.warning.set_visible(True)
            self.save_button.set_sensitive(True)
            self.again.set_visible(True)
            self.save_button.grab_focus()
            return
        self.show_keys("")
        if status == "cancelled":
            self.prompt.set_text(_("Recording cancelled"))
        elif status == "timeout":
            self.prompt.set_text(_("Time is up"))
        elif status == "rejected":
            self.prompt.set_text(_("This combination cannot be assigned"))
            self.error.set_text(answer.get("error", ""))
            self.error.set_visible(True)
        else:
            self.prompt.set_text(_("Recording is unavailable"))
            self.error.set_text(answer.get("error", ""))
            self.error.set_visible(True)
        self.again.set_visible(status != "unavailable")

    def choose(self):
        if self.binding is None:
            return
        problem = self.on_chosen(self.binding)
        if problem:
            self.error.set_text(problem)
            self.error.set_visible(True)
        else:
            self.close()

    def on_closed(self, *_):
        # Закрыли окно, не дождавшись: клавиатура сразу возвращается человеку.
        if not self.finished:
            try:
                self.daemon.call("CancelHotkeyRecording")
            except GLib.Error:
                pass
        self.finished = True


class HotkeysPage(Gtk.Box):
    """Два набора горячих клавиш и их правка. Запись сочетания делает демон."""

    can_add = False
    searchable = False

    SCHEMES = (("apple", "Apple"), ("pc", "PC"))
    CHOICES = (
        ("auto", _("Auto — by keyboard")),
        ("apple", _("Always the Apple set")),
        ("pc", _("Always the PC set")),
    )
    NOTES = {
        "word": _("Fixes the word you are typing; right after a word, undoes the last "
                  "replacement. Pressing again cycles through the readings."),
        "selection": _("Replaces the selected text with its reading in the other layout."),
        "toggle_app": _("Cycles the mode for the application you are in: automatic, hotkey only, "
                        "off."),
        "report": _("Writes the last eight decisions to reports.jsonl."),
        "apple_layout": _("Turns the Apple layout of the system on or off, at once. Useful when "
                          "an Apple and an ordinary keyboard are connected together: the Apple "
                          "layout applies to both, and this key brings the ordinary one back."),
    }
    TITLES = {
        "word": _("Change the layout of the word"),
        "selection": _("Convert the selected text"),
        "toggle_app": _("Cycle the mode for the application"),
        "report": _("Report a wrong correction"),
        "apple_layout": _("Turn the Apple layout on or off"),
    }

    def __init__(self, win, daemon):
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        self.win = win
        self.daemon = daemon
        self.name = "hotkeys"
        self.title = _("Hotkeys")
        self.state = {}
        self._refreshing = False

        self.stack = Gtk.Stack(vexpand=True)
        self.containers = {}
        for scheme, title in self.SCHEMES:
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24)
            self.containers[scheme] = box
            clamp = Adw.Clamp(maximum_size=640, tightening_threshold=480, child=box,
                              margin_top=12, margin_bottom=24, margin_start=12, margin_end=12)
            scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, vexpand=True, child=clamp)
            self.stack.add_titled(scroller, scheme, title)
        switcher = Gtk.StackSwitcher(stack=self.stack, halign=Gtk.Align.CENTER)

        self.choice = Adw.ComboRow(title=_("Which set to use"))
        self.choice.set_model(Gtk.StringList.new([label for _id, label in self.CHOICES]))
        self.choice.connect("notify::selected", self.on_choice)
        choice_group = Adw.PreferencesGroup(
            description=_("The set is chosen by keyboard: Apple keyboards use the Apple set, all "
                          "others the PC set. A laptop and an Apple keyboard plugged into it each keep to "
                          "their own habits.")
        )
        choice_group.add(self.choice)
        self.keyboards_label = dim_label("")
        choice_group.add(self.keyboards_label)

        top = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                      margin_top=12, margin_start=12, margin_end=12)
        top.append(Adw.Clamp(maximum_size=640, tightening_threshold=480, child=choice_group))
        top.append(switcher)
        self.append(top)
        self.append(self.stack)

    # -- data ------------------------------------------------------------

    @guarded
    def refresh(self):
        try:
            self.state = json.loads(self.daemon.call("GetHotkeys"))
        except (ValueError, TypeError):
            self.state = {}
        if not self.state:
            return
        self._refreshing = True
        ids = [choice for choice, _label in self.CHOICES]
        self.choice.set_selected(ids.index(self.state.get("choice", "auto")) if self.state.get("choice") in ids else 0)
        self._refreshing = False
        names = {"apple": "Apple", "pc": "PC"}
        keyboards = self.state.get("keyboards") or []
        self.keyboards_label.set_text(
            _("Currently connected: ")
            + "; ".join(
                _("{name} — set {scheme}").format(name=k["name"], scheme=names.get(k["scheme"], k["scheme"]))
                for k in keyboards
            )
            if keyboards
            else _("No keyboards found.")
        )
        for scheme, _title in self.SCHEMES:
            self.rebuild(scheme)

    def rebuild(self, scheme):
        box = self.containers[scheme]
        child = box.get_first_child()
        while child is not None:
            following = child.get_next_sibling()
            box.remove(child)
            child = following
        titles = {action["id"]: self.TITLES.get(action["id"], action["title"]) for action in self.state.get("actions", [])}
        entries = self.state["sets"][scheme]
        for action in self.state.get("actions", []):
            box.append(self.action_group(scheme, action["id"], titles[action["id"]], entries[action["id"]]))

        emergency = Adw.PreferencesGroup(title=_("Cannot be changed"))
        row = plain_row(
            _("Emergency release of the grab"),
            _("Press all three together: PuLinTo releases the keyboard until restart."),
        )
        row.set_subtitle_lines(0)
        row.add_suffix(keycaps("Backspace", "Esc", "Enter"))
        emergency.add(row)
        box.append(emergency)

        reset = Gtk.Button(label=_("Reset the set"), halign=Gtk.Align.CENTER)
        reset.add_css_class("destructive-action")
        reset.set_sensitive(not all(entry["is_default"] for entry in entries.values()))
        reset.connect("clicked", lambda *_: self.confirm_reset_set(scheme))
        box.append(reset)

    def action_group(self, scheme, action, title, entry):
        group = Adw.PreferencesGroup(title=title, description=self.NOTES.get(action, ""))
        reset = Gtk.Button(label=_("Reset"), valign=Gtk.Align.CENTER, visible=not entry["is_default"])
        reset.add_css_class("flat")
        reset.connect("clicked", lambda *_: self.reset(scheme, action))
        group.set_header_suffix(reset)

        bindings = entry["bindings"]
        if not bindings:
            row = plain_row(_("Off"), _("There is no combination: the action does not "
                                              "trigger."))
            group.add(row)
        for index, binding in enumerate(bindings):
            group.add(self.binding_row(scheme, action, title, bindings, index))
        add = Adw.ActionRow(title=_("Add a shortcut…"), activatable=True)
        add.add_prefix(Gtk.Image(icon_name="list-add-symbolic"))
        add.connect("activated", lambda *_: self.edit(scheme, action, title, bindings, None))
        group.add(add)
        return group

    @staticmethod
    def tap_label(text):
        """`tap:ralt` as "Right Alt"."""
        name = text[len("tap:"):]
        side = ""
        if name[:1] in ("l", "r") and name[1:] in ("alt", "ctrl", "shift", "meta"):
            side, name = name[0], name[1:]
        key = {"alt": "Alt", "ctrl": "Ctrl", "shift": "Shift", "meta": "Meta"}.get(name, name)
        if side == "l":
            return _("Left {key}").format(key=key)
        if side == "r":
            return _("Right {key}").format(key=key)
        return key

    def binding_row(self, scheme, action, title, bindings, index):
        binding = bindings[index]
        is_tap = binding["text"].startswith("tap:")
        row = Adw.ActionRow(
            title=_("Single press") if is_tap else _("Combination"), use_markup=False
        )
        # The daemon's own label is in Russian; the window builds the key names itself.
        label = self.tap_label(binding["text"]) if is_tap else binding["label"]
        row.add_prefix(keycaps(*(label.split("+") if not is_tap else [label])))
        edit = Gtk.Button(label=_("Edit"), valign=Gtk.Align.CENTER)
        edit.connect("clicked", lambda *_: self.edit(scheme, action, title, bindings, index))
        row.add_suffix(edit)
        row.add_suffix(
            icon_button(
                "user-trash-symbolic", _("Remove this shortcut"),
                lambda: self.save(scheme, action, [b["text"] for i, b in enumerate(bindings) if i != index]),
            )
        )
        return row

    # -- changes ---------------------------------------------------------

    def edit(self, scheme, action, title, bindings, index):
        heading = _("New shortcut") if index is None else _("Change shortcut")

        def chosen(text):
            texts = [b["text"] for b in bindings]
            if index is None:
                texts.append(text)
            else:
                texts[index] = text
            return self.save(scheme, action, texts)

        HotkeyRecorder(self, scheme, action, heading, title, chosen).present(self.win)

    def save(self, scheme, action, texts):
        """Returns None on success or the daemon's reason in words."""
        try:
            answer = json.loads(self.daemon.call("SetHotkey", "(ssas)", scheme, action, texts))
        except (GLib.Error, ValueError) as error:
            return str(error)
        if not answer.get("ok"):
            return answer.get("error") or _("Could not save.")
        self.refresh()
        warnings = answer.get("warnings") or []
        self.win.toast((_("Saved. ") + warnings[0]) if warnings else _("Saved"))
        return None

    def report(self, answer, done):
        if answer.get("ok"):
            self.refresh()
            self.win.toast(done)
        else:
            alert(self.win, _("It did not work"), answer.get("error") or "")

    @guarded
    def reset(self, scheme, action):
        answer = json.loads(self.daemon.call("ResetHotkeys", "(ss)", scheme, action))
        self.report(answer, _("Reset"))

    def confirm_reset_set(self, scheme):
        names = dict(self.SCHEMES)
        dialog = Adw.AlertDialog(
            heading=_("Reset the {name} set?").format(name=names[scheme]),
            body=_("All shortcuts of this set will return to their defaults."),
        )
        dialog.add_response("cancel", _("Cancel"))
        dialog.add_response("reset", _("Reset"))
        dialog.set_response_appearance("reset", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")
        dialog.connect("response", lambda _d, response: self.finish_reset_set(scheme, response))
        dialog.present(self.win)

    @guarded
    def finish_reset_set(self, scheme, response):
        if response != "reset":
            return
        answer = json.loads(self.daemon.call("ResetHotkeys", "(ss)", scheme, ""))
        self.report(answer, _("Set reset"))

    @guarded
    def on_choice(self, row, _param):
        if self._refreshing:
            return
        choice = self.CHOICES[row.get_selected()][0]
        answer = json.loads(self.daemon.call("SetHotkeyChoice", "(s)", choice))
        self.report(answer, _("Set choice saved"))


