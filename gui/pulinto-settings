        defaults_box.append(self.defaults_note)
        defaults_box.append(self.defaults)
        self.defaults_box = defaults_box
        self.content.append(mine_box)
        self.content.append(defaults_box)

    def listboxes(self):
        return [self.mine, self.defaults]

    def set_search(self, text):
        super().set_search(text)
        self.mine_placeholder.set_text(
            _("Nothing found")
            if self.search_text
            else _("You have no rules yet. PuLinTo handles all other applications automatically.")
        )

    def explicit_rows(self):
        return [(app, mode) for app, mode, explicit in self._rows if explicit]

    def _build_row(self, app, mode, explicit):
        row = plain_row(app, None if explicit else _("default"))
        row.set_title_lines(1)
        row.set_activatable(True)
        label = value_label(self.MODES[mode])
        if mode == "off":
            label.add_css_class("error")
            label.remove_css_class("dim-label")
        row.add_suffix(label)
        if explicit:
            row.add_suffix(
                icon_button(
                    "edit-undo-symbolic",
                    _("Restore the default"),
                    lambda r=row: self.delete_row(r),
                )
            )
        row.rule = (app, mode, explicit)
        row.search_key = f"{app} {self.MODES[mode]}".lower()
        return row

    @guarded
    def refresh(self):
        enabled = set(self.daemon.call("ListEnabledApps"))
        manual = set(self.daemon.call("ListManualApps"))
        disabled = set(self.daemon.call("ListDisabledApps"))
        default_manual = set(self.daemon.call("ListDefaultManualApps"))
        default_off = set(self.daemon.call("ListDefaultOffApps"))
        self.clear(self.mine)
        self.clear(self.defaults)
        self._rows = []
        for app in sorted(enabled):
            self._rows.append((app, "auto", True))
        for app in sorted(manual):
            self._rows.append((app, "manual", True))
        for app in sorted(disabled):
            self._rows.append((app, "off", True))
        explicit = enabled | manual | disabled
        for app in sorted(default_manual - explicit):
            self._rows.append((app, "manual", False))
        for app in sorted(default_off - explicit):
            self._rows.append((app, "off", False))
        defaults = 0
        for app, mode, is_explicit in self._rows:
            (self.mine if is_explicit else self.defaults).append(self._build_row(app, mode, is_explicit))
            defaults += 0 if is_explicit else 1
        self.defaults_box.set_visible(defaults > 0)
        self.show_rows(bool(self._rows))
        self.win.set_count(self.name, len(self.explicit_rows()))

    def add(self):
        self.open_form()

    def edit_row(self, row):
        app, mode, _explicit = row.rule
        self.open_form(app, mode)

    @guarded
    def delete_row(self, row):
        app, mode, explicit = row.rule
        if not explicit:
            return
        self.daemon.call("ResetAppPolicy", "(s)", app)
        self.win.refresh_all()

        def undo():
            if self.daemon.call("SetAppMode", "(ss)", app, mode):
                self.win.refresh_all()

        self.win.toast(_("Rule reset"), undo=undo)

    def open_form(self, initial_app="", initial_mode="manual"):
        win = self.win
        editing = bool(initial_app)

        def on_save():
            app = app_row.get_text().strip()
            mode = self.MODE_ORDER[mode_row.get_selected()]
            try:
                ok = self.daemon.call("SetAppMode", "(ss)", app, mode)
            except GLib.Error as error:
                win.daemon_failed(error)
                return _("No connection to PuLinTo.")
            if not ok:
                return _("The rule was not saved.")
            win.refresh_all()
            win.toast(_("Saved"))
            return None

        dialog = FormDialog(_("Rule for an application") if editing else _("New rule"), on_save)
        group = Adw.PreferencesGroup(
            description=_("Window class (WM_CLASS), for example Navigator or jetbrains-*.")
        )
        app_row = Adw.EntryRow(title=_("Application"), text=initial_app)
        group.add(app_row)
        dialog.watch(app_row)
        dialog.require(lambda: bool(app_row.get_text().strip()))
        mode_row = Adw.ComboRow(title=_("Mode"), model=Gtk.StringList.new(list(self.MODES.values())))
        mode_row.set_selected(self.MODE_ORDER.index(initial_mode))
        group.add(mode_row)
        dialog.add_group(group)

        dialog.add_group(
            dim_label(
                _("Automatic: automatic fixes and the hotkey.\nHotkey only: no automatic "
                  "replacements.\nCompletely off: PuLinTo handles nothing, not even the "
                  "hotkey.\nThe key is set on the \"Hotkeys\" page: Alt or Pause/Break on an "
                  "Apple keyboard, Pause/Break or the right Ctrl on the others.")
            )
        )
        dialog.finish_layout()
        dialog.present(win)
        GLib.idle_add(app_row.grab_focus)


