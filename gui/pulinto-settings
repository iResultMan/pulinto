class Daemon:
    def __init__(self):
        self.proxy = Gio.DBusProxy.new_for_bus_sync(
            Gio.BusType.SESSION,
            Gio.DBusProxyFlags.NONE,
            None,
            BUS_NAME,
            OBJECT_PATH,
            INTERFACE,
            None,
        )

    def call(self, method, signature=None, *args):
        params = GLib.Variant(signature, args) if signature else None
        reply = self.proxy.call_sync(
            method, params, Gio.DBusCallFlags.NONE, 5000, None
        ).unpack()
        return reply[0] if len(reply) == 1 else reply


def connect_or_start_daemon():
    """Return a live daemon proxy, starting the local daemon when necessary."""
    last_error = None
    try:
        daemon = Daemon()
        daemon.call("Status")
        return daemon
    except GLib.Error as error:
        last_error = error

    candidates = [
        os.environ.get("PULINTO_DAEMON", "").strip(),
        "/usr/local/bin/pulintod",
        "pulintod",
    ]
    for program in candidates:
        if not program:
            continue
        try:
            subprocess.Popen(
                [program],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            break
        except OSError as error:
            last_error = error
    else:
        raise RuntimeError(_("could not start pulintod: {error}").format(error=last_error))

    # D-Bus registration follows process start; on a cold desktop it can take
    # a little longer while dictionaries and the layout controller initialise.
    for _attempt in range(30):
        time.sleep(0.1)
        try:
            daemon = Daemon()
            daemon.call("Status")
            return daemon
        except GLib.Error as error:
            last_error = error
    raise RuntimeError(_("pulintod is running but did not register on D-Bus: {error}").format(error=last_error))


def plural(count, one, many):
    """`count` and the right form of a noun. `one` and `many` are the English
    catalogue keys; the catalogue knows how many forms its language has."""
    return f"{count} {_catalogue.ngettext(one, many, count)}"


def gui_state_path():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(base, "pulinto", "gui.json")


def gui_state():
    try:
        with open(gui_state_path(), "r", encoding="utf-8") as handle:
            data = json.load(handle)
            return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def remember_gui_state(**values):
    state = gui_state()
    state.update(values)
    try:
        os.makedirs(os.path.dirname(gui_state_path()), exist_ok=True)
        with open(gui_state_path(), "w", encoding="utf-8") as handle:
            json.dump(state, handle, ensure_ascii=False)
    except OSError:
        pass


def guarded(method):
    """Turn a lost daemon connection into a visible message instead of a traceback."""

    @functools.wraps(method)
    def wrapper(self, *args, **kwargs):
        try:
            return method(self, *args, **kwargs)
        except GLib.Error as error:
            getattr(self, "win", self).daemon_failed(error)
            return None

    return wrapper


def alert(parent, heading, body=None):
    dialog = Adw.AlertDialog(heading=heading, body=body or "")
    dialog.add_response("ok", _("Got it"))
    dialog.set_default_response("ok")
    dialog.set_close_response("ok")
    dialog.present(parent)
    return dialog


def pill_button(label, callback):
    button = Gtk.Button(label=label, halign=Gtk.Align.CENTER)
    button.add_css_class("pill")
    button.add_css_class("suggested-action")
    button.connect("clicked", lambda *_: callback())
    return button


def dim_label(text, **kwargs):
    label = Gtk.Label(label=text, xalign=0, wrap=True, **kwargs)
    label.add_css_class("dim-label")
    return label


def value_label(text="", mono=False):
    label = Gtk.Label(label=text, xalign=1, valign=Gtk.Align.CENTER)
    label.add_css_class("dim-label")
    if mono:
        label.add_css_class("mono")
    return label


def chip(text, tooltip=None):
    label = Gtk.Label(label=text, valign=Gtk.Align.CENTER)
    label.add_css_class("chip")
    if tooltip:
        label.set_tooltip_text(tooltip)
    return label


def icon_button(icon, tooltip, callback):
    button = Gtk.Button(icon_name=icon, valign=Gtk.Align.CENTER, tooltip_text=tooltip)
    button.add_css_class("flat")
    button.update_property([Gtk.AccessibleProperty.LABEL], [tooltip])
    button.connect("clicked", lambda *_: callback())
    return button


def plain_row(title, subtitle=None):
    row = Adw.ActionRow(title=title, use_markup=False)
    if subtitle:
        row.set_subtitle(subtitle)
    return row


