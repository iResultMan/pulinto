class FormDialog(Adw.Dialog):
    """Title, Cancel/Save in the header, Enter saves, Escape cancels.

    `on_save()` returns None on success or an error text that stays in the
    dialog, so a rejected value never costs the person what they typed.
    """

    def __init__(self, title, on_save, save_label=_("Save")):
        super().__init__(title=title, content_width=460)
        self._on_save = on_save
        self._validators = []

        header = Adw.HeaderBar(show_start_title_buttons=False, show_end_title_buttons=False)
        cancel = Gtk.Button(label=_("Cancel"))
        cancel.connect("clicked", lambda *_: self.close())
        self.save_button = Gtk.Button(label=save_label)
        self.save_button.add_css_class("suggested-action")
        self.save_button.connect("clicked", lambda *_: self.save())
        header.pack_start(cancel)
        header.pack_end(self.save_button)

        self.body = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=18,
            margin_top=6,
            margin_bottom=24,
            margin_start=18,
            margin_end=18,
        )
        self.error = Gtk.Label(xalign=0, wrap=True, visible=False)
        self.error.add_css_class("error")

        view = Adw.ToolbarView()
        view.add_top_bar(header)
        view.set_content(self.body)
        self.set_child(view)
        self.set_default_widget(self.save_button)

    def add_group(self, group):
        self.body.append(group)

    def finish_layout(self):
        self.body.append(self.error)
        self.update()

    def require(self, check):
        """`check()` returns True when the form may be saved."""
        self._validators.append(check)

    def watch(self, entry):
        entry.connect("changed", lambda *_: self.update())
        entry.connect("entry-activated", lambda *_: self.save())

    def update(self):
        self.error.set_visible(False)
        self.save_button.set_sensitive(all(check() for check in self._validators))

    def save(self):
        if not self.save_button.get_sensitive():
            return
        problem = self._on_save()
        if problem:
            self.error.set_text(problem)
            self.error.set_visible(True)
        else:
            self.close()


