    # -- construction ----------------------------------------------------

    def build_actions(self):
        for name, callback in [
            ("refresh", lambda *_: self.safe_refresh()),
            ("restart-input", lambda *_: self.restart_input()),
            ("import", lambda *_: self.import_rules()),
            ("export", lambda *_: self.export_rules()),
            ("find", lambda *_: self.focus_search()),
            ("add", lambda *_: self.add_to_current()),
            ("help", lambda *_: self.show_page("help")),
