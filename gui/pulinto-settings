class DiagnosticsPage(Adw.PreferencesPage):
    """The in-memory diagnostics and the debug mode (see `crates/pulintod/src/debug.rs`)."""

    can_add = False
    searchable = False

    # id, title, subtitle, on by default
    OPTIONS = (
        ("panic", _("Full text of a crash"),
         _("The message and the backtrace of a panic. Without it the log only says where it happened."), True),
        ("decisions", _("Every decision"),
         _("A line for each word, including the ones left alone: the stage, the layout, the time."), True),
        ("text", _("Typed words"),
         _("The words and what they became. Words that the stop rules take out (passwords, "
           "addresses) are not written."), False),
        ("keys", _("Every key"),
         _("Each key read and each key sent, with the time. This records passwords too; it stops "
           "after 15 minutes."), False),
    )

    def __init__(self, win, daemon):
        super().__init__()
        self.win = win
        self.daemon = daemon
        self.name = "diagnostics"
        self.title = _("Diagnostics")
        self._timer = None

        self.debug_group = Adw.PreferencesGroup(
            title=_("Debug mode"),
            description=_("For finding a fault together with the developer. While it records, a red "
                          "dot shows on the tray icon. The record is kept in memory, not on "
                          "the disk; it stops by itself after an hour and is deleted when you switch "
                          "the mode off."),
        )
        self.option_rows = {}
        for oid, title, subtitle, default in self.OPTIONS:
            option = Adw.SwitchRow(title=title, subtitle=subtitle, active=default)
            option.set_subtitle_lines(0)
            self.option_rows[oid] = option
            self.debug_group.add(option)
        self.state_row = plain_row("")
        self.start_row = self.action_row(_("Start recording"), self.confirm_start)
        self.save_row = self.action_row(_("Stop and save a copy"), lambda: self.stop(True))
        self.delete_row = self.action_row(_("Stop and delete"), lambda: self.stop(False))
        self.delete_row.add_css_class("error")
        self.debug_group.add(self.state_row)
        for row in (self.start_row, self.save_row, self.delete_row):
            self.debug_group.add(row)
        self.add(self.debug_group)
        self.connect("map", lambda *_: self.refresh())

        group = Adw.PreferencesGroup(
            title=_("Diagnostics"),
            description=_("PuLinTo keeps the last lines of its work in memory only, never in a file. "
                          "They hold no words you typed. Copy them to attach to a bug report."),
        )
        row = plain_row(_("Last lines of the log"))
        row.add_suffix(pill_button(_("Copy"), self.copy_diagnostics))
        group.add(row)
        self.add(group)

    @staticmethod
    def action_row(title, callback):
        row = plain_row(title)
        row.set_activatable(True)
        row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
        row.connect("activated", lambda *_: callback())
        return row

    @guarded
    def copy_diagnostics(self):
        text = self.daemon.call("GetDiagnostics")
        self.get_clipboard().set(text)
        self.win.toast(_("Copied"))

    def selected(self):
        return [oid for oid, row in self.option_rows.items() if row.get_active()]

    def confirm_start(self):
        chosen = self.selected()
        if not chosen:
            self.win.toast(_("Choose at least one option"))
            return
        if "text" in chosen or "keys" in chosen:
            dialog = Adw.AlertDialog(
                heading=_("Record what you type?"),
                body=_("The record will hold your texts. Passwords typed while \"Every key\" is on "
                       "are recorded too. Nothing is written to the disk, and the record is deleted "
                       "when you stop; you decide whether to save a copy."),
            )
            dialog.add_response("cancel", _("Cancel"))
            dialog.add_response("start", _("Start"))
            dialog.set_response_appearance("start", Adw.ResponseAppearance.DESTRUCTIVE)
            dialog.set_default_response("cancel")
            dialog.set_close_response("cancel")
            dialog.connect("response", lambda _d, response: self.start(chosen) if response == "start" else None)
            dialog.present(self.win)
        else:
            self.start(chosen)

    @guarded
    def start(self, chosen):
        if not self.daemon.call("StartDebug", "(as)", chosen):
            alert(self.win, _("Debug mode did not start"),
                  _("See the daemon log: journalctl --user -u pulintod -n 20"))
        self.refresh()

    @guarded
    def stop(self, save):
        path = self.daemon.call("StopDebug", "(b)", save)
        self.refresh()
        if path:
            alert(self.win, _("A copy is saved"),
                  _("{path}\n\nLook through it before sending: it may hold your texts. The "
                    "record itself is deleted.").format(path=path))
        else:
            self.win.toast(_("The record is deleted"))

    @guarded
    def refresh(self):
        try:
            state = json.loads(self.daemon.call("GetDebug"))
        except (ValueError, TypeError):
            state = {}
        recording = bool(state.get("recording"))
        leftover = bool(state.get("leftover"))
        active = set(state.get("options") or [])
        for oid, row in self.option_rows.items():
            row.set_sensitive(not recording and not leftover)
            if recording:
                row.set_active(oid in active)
        self.start_row.set_visible(not recording and not leftover)
        self.save_row.set_visible(recording or leftover)
        self.delete_row.set_visible(recording or leftover)
        if recording:
            minutes = -(-int(state.get("seconds_left", 0)) // 60)
            self.state_row.set_title(_("Recording · {minutes} min left").format(minutes=minutes))
            self.state_row.add_css_class("error")
        elif leftover:
            self.state_row.set_title(_("A finished record is kept in memory"))
            self.state_row.remove_css_class("error")
        else:
            self.state_row.set_title(_("Not recording"))
            self.state_row.remove_css_class("error")
        # Follow the daemon while the page is on screen (the mode may be switched from the tray)
        # and, while it records, until it stops.
        if self._timer is None and (recording or self.get_mapped()):
            self._timer = GLib.timeout_add_seconds(1 if recording else 2, self._tick)

    def _tick(self):
        self._timer = None
        self.refresh()
        return False


